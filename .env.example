# Copie este arquivo para .env antes de rodar o projeto.

# Postgres — local (ver README/DEPLOY.md pra instalar) ou a connection string do
# provedor gerenciado (Neon, Vercel Postgres, Supabase etc.).
DATABASE_URL="postgresql://usuario@localhost:5432/feitoaqui"

# Token de leitura/escrita do Vercel Blob (upload de fotos) — criado ao linkar um
# Blob store no projeto na Vercel. Ver DEPLOY.md.
BLOB_READ_WRITE_TOKEN=""
